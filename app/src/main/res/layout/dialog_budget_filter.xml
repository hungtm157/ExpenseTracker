<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn thời gian lọc"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Year Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPrevYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvSelectedYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="2026"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnNextYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chọn tháng"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Month Grid -->
    <GridLayout
        android:id="@+id/gridMonths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Months will be populated programmatically or we can define them here -->
        <!-- For simplicity and styling control, I'll programmatically populate them in the Dialog class,
             or define 12 TextViews here. Let's use 12 TextViews for preview and easier styling. -->

        <TextView
            style="@style/MonthItemStyle"
            android:tag="1"
            android:text="Tháng 1" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="2"
            android:text="Tháng 2" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="3"
            android:text="Tháng 3" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="4"
            android:text="Tháng 4" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="5"
            android:text="Tháng 5" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="6"
            android:text="Tháng 6" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="7"
            android:text="Tháng 7" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="8"
            android:text="Tháng 8" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="9"
            android:text="Tháng 9" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="10"
            android:text="Tháng 10" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="11"
            android:text="Tháng 11" />

        <TextView
            style="@style/MonthItemStyle"
            android:tag="12"
            android:text="Tháng 12" />

    </GridLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white_rounded"
            android:gravity="center"
            android:text="Hiện tại"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_green"
            android:gravity="center"
            android:text="Xong"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
